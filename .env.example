# --- Gemini (backend only, never exposed to the frontend) ---
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=

# --- Database (Supabase Postgres) ---
# Project Settings -> Database -> "Transaction pooler" connection string.
# Use the pooler (not the direct connection) so this stays safe on hosts
# that open many short-lived connections (e.g. Render's free tier).
DATABASE_URL=

# --- Supabase (backend only — service role bypasses RLS, never expose it) ---
# Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- API server ---
PORT=4000
# The deployed frontend origin, used for the CORS allowlist. Comma-separate
# multiple origins if needed (e.g. local dev + prod).
WEB_ORIGIN=http://localhost:3000

# --- Google OAuth (read by supabase/config.toml's [auth.external.google]) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Redirect URI: http://127.0.0.1:54321/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
